{
  "name": "@zenshin/api",
  "version": "1.3.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "npm run db:migrate:deploy && tsx watch src/index.ts",
    "db:migrate:dev": "npx prisma migrate dev --schema=../../packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=../../packages/db/prisma/schema.prisma",
    "db:migrate:status": "npx prisma migrate status --schema=../../packages/db/prisma/schema.prisma",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretest": "cd ../.. && npm run build -w @zenshin/db",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@zenshin/db": "*",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.4.2"
  }
}
