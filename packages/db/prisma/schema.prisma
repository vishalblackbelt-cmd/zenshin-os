datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  INSTRUCTOR
  PARENT
  STUDENT
}

enum TrialStatus {
  NEW
  PAID
  TRIAL_COMPLETED
  JOINED
  LOST
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
}

model Branch {
  id        String      @id @default(uuid())
  name      String      @unique // "Sirifort" or "Asiad"
  users     User[]
  students  Student[]
  trials    TrialLead[]
  auditLogs AuditLog[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   // bcrypt hashed
  role      Role
  branchId  String?  // null for global OWNER
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                 String           @id // ZD0001, AD0001, etc.
  name               String
  age                Int
  category           String           // "Kids", "Teens", "Adults"
  parentName         String
  mobile             String
  joiningDate        DateTime         @default(now())
  currentBelt        String
  status             StudentStatus    @default(ACTIVE)
  feeDueDate         DateTime
  outstandingBalance Int              @default(0)
  attendanceRate     Int              @default(100)
  examEligible       Boolean          @default(true)
  branchId           String
  branch             Branch           @relation(fields: [branchId], references: [id])
  attendances        Attendance[]
  ledgerEntries      LedgerEntry[]
  timelineEvents     TimelineEvent[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TrialLead {
  id         String      @id @default(uuid())
  name       String
  mobile     String
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id])
  status     TrialStatus @default(NEW)
  paidAmount Int         @default(0) // ₹500 when paid
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus
  batch     String           // "Kids (5:00 PM)", etc.
  createdAt DateTime         @default(now())
}

model LedgerEntry {
  id          String          @id @default(uuid())
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        LedgerEntryType
  amount      Int
  description String
  createdAt   DateTime        @default(now())
}

model Settings {
  id                 String @id @default("global")
  maxGracePeriod     Int    @default(10)
  reactivationCharge Int    @default(1000)
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  actor     String
  role      Role
  action    String
  details   String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
}

model TimelineEvent {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        String
  description String
}
